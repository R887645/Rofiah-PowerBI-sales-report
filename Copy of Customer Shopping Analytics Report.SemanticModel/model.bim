            "expression": [
              "",
              "VAR CurrentOrders = [Order_Count]",
              "VAR PrevYearOrders = CALCULATE([Order_Count], DATEADD('Calendar'[Date], -1, YEAR))",
              "RETURN CurrentOrders - PrevYearOrders"
            ],
            "formatString": "0",
            "lineageTag": "6f7b65ce-cbee-478f-b3f2-a0b8a5bcee8b"
          },
          {
            "name": "PY_Orders",
            "displayFolder": "Order",
            "expression": [
              "",
              "CALCULATE([Order_Count], DATEADD('Calendar'[Date], -1, YEAR))"
            ],
            "formatString": "0",
            "lineageTag": "d3a5ced4-fd3f-46ff-8b99-8ef132f58a0d"
          },
          {
            "name": "YoY_Order_count",
            "displayFolder": "Order",
            "expression": [
              "",
              "VAR Positive_Arrow = UNICHAR(9650)   // ▲ POSITIVE ARROW",
              "VAR Negative_Arrow = UNICHAR(9660)   // ▼ NEGATIVE ARROW",
              "VAR currorder = [Order_Count]",
              "VAR PYOrder = [PY_Orders]",
              "VAR Growth = DIVIDE(currorder - PYOrder, PYOrder, 0)",
              "RETURN",
              "    IF(Growth > 0, Positive_Arrow, Negative_Arrow)& \"  \"",
              "    & ROUND(Growth * 100, 2) & \"%\"",
              ""
            ],
            "lineageTag": "cd07fe88-1abe-4e9f-8e70-a29d49513b5e"
          },
          {
