          {
            "name": "MoM_Order_count",
            "displayFolder": "Order",
            "expression": [
              "",
              "VAR Positive_Arrow = UNICHAR(9650)   // ▲ POSITIVE ARROW",
              "VAR Negative_Arrow = UNICHAR(9660)   // ▼ NEGATIVE ARROW",
              "VAR currorder = [Order_Count]",
              "VAR PMOrder = [PM_Order]",
              "VAR Growth = DIVIDE(currorder - PMOrder, PMOrder, 0)",
              "RETURN",
              "    IF(Growth > 0, Positive_Arrow, Negative_Arrow)& \"  \"",
