        "lineageTag": "079d042a-a535-4505-8737-34568d6e0ab3",
        "measures": [
          {
            "name": "Total Revenue",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"tr-TR\"}"
              }
            ],
            "displayFolder": "Rev",
            "expression": "SUM(Customer_FACT[price])",
            "formatString": "\"₺\"#,0.00;-\"₺\"#,0.00;\"₺\"#,0.00",
            "lineageTag": "1af2b31b-52d5-4a2c-acff-21b7908491b6"
          },
          {
            "name": "M_Rev_Var",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "displayFolder": "Rev",
            "expression": [
              "[Total Revenue] - [PM_Rev]",
              ""
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "a68dab9e-95af-4eeb-815e-80dc80650bca"
          },
          {
            "name": "PM_Rev",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"tr-TR\"}"
              }
            ],
            "displayFolder": "Rev",
            "expression": [
              "CALCULATE(",
              "    [Total Revenue],",
              "    DATEADD('Calendar'[Date], -1, MONTH)",
              ")",
              ""
            ],
            "formatString": "\"₺\"#,0.00;-\"₺\"#,0.00;\"₺\"#,0.00",
            "lineageTag": "453298c3-9e6e-42fc-8da9-e01e7515d8e6"
          },
          {
            "name": "Total Quantity",
            "displayFolder": "Quantity",
            "expression": [
              "",
              "SUM(Customer_FACT[quantity])"
            ],
            "formatString": "0",
            "lineageTag": "147dec34-f631-4e89-aee3-e528f3bf64fd"
          },
          {
            "name": "Order_Count",
            "displayFolder": "Order",
            "expression": "DISTINCTCOUNT(Customer_FACT[invoice_no])",
            "formatString": "#,0",
            "lineageTag": "4a8087a1-cc09-4702-87c1-1c85be03c7bb"
          },
          {
            "name": "Average Order Value (AOV)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"tr-TR\"}"
              }
            ],
            "displayFolder": "AOV",
            "expression": [
              "",
              "DIVIDE([Total Revenue], [Order_Count])"
            ],
            "formatString": "\"₺\"#,0.00;-\"₺\"#,0.00;\"₺\"#,0.00",
            "lineageTag": "8dc1031c-d7d0-435e-a668-84dcc4b7ffad"
          },
          {
            "name": "MoM_new_Rev",
            "displayFolder": "Rev",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue] - [PM_Rev],",
              "    [PM_Rev],",
              "    0",
              ")",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "39b995cd-abab-4ed8-8cd0-31999892b69d"
          },
          {
            "name": "MoM_rev",
            "displayFolder": "Rev",
            "expression": [
              "",
              "VAR Positive_Arrow = UNICHAR(9650)   // ▲ POSITIVE ARROW",
              "VAR Negative_Arrow = UNICHAR(9660)   // ▼ NEGATIVE ARROW",
              "VAR Rev = [Total Revenue]",
              "VAR PMRev = [PM_Rev]",
              "VAR Growth = DIVIDE(Rev - PMRev, PMRev, 0)",
              "RETURN",
              "    IF(Growth > 0, Positive_Arrow, Negative_Arrow)& \"  \"",
              "    & ROUND(Growth * 100, 2) & \"%\"",
              ""
            ],
            "lineageTag": "3014a4d2-4f61-41ca-a463-62de448bec0e"
          },
          {
            "name": "MoM_Colour_Rev",
            "displayFolder": "Rev",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    [MoM_new_Rev] > 0, \"Green\",",
              "    [MoM_new_Rev] < 0, \"RED\",",
              "    \"#000000\"",
              ")",
              ""
            ],
            "lineageTag": "d6512624-a1c9-459c-b7ea-425162bdd606"
          },
          {
            "name": "PM_QTY",
            "displayFolder": "Quantity",
            "expression": [
              "CALCULATE([Total Quantity],",
              "                    DATEADD('Calendar'[Date],-1,MONTH))"
            ],
            "formatString": "0",
            "lineageTag": "14a6c8d2-c56a-4650-b2f3-0bee24976e5e"
          },
          {
            "name": "MoM_QTY",
            "displayFolder": "Quantity",
            "expression": [
              "",
              "VAR Positive_Arrow = UNICHAR(9650)   // ▲ POSITIVE ARROW",
              "VAR Negative_Arrow = UNICHAR(9660)   // ▼ NEGATIVE ARROW",
              "VAR QTY = [Total Quantity]",
              "VAR PMQTY = [PM_QTY]",
              "VAR Growth = DIVIDE(QTY - PMQTY, PMQTY, 0)",
              "RETURN",
              "    IF(Growth > 0, Positive_Arrow, Negative_Arrow)& \"  \"",
              "    & ROUND(Growth * 100, 2) & \"%\"",
              ""
            ],
            "lineageTag": "9742702c-3533-414a-84a4-4574a942119e"
