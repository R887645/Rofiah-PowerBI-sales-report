            "dataType": "string",
            "expression": [
              "",
              "VAR OrderCount =",
              "    CALCULATE(",
              "        DISTINCTCOUNT(Customer_FACT[invoice_no]),",
              "        FILTER(Customer_FACT, Customer_FACT[customer_id] = EARLIER(Customer_FACT[customer_id]))",
              "    )",
              "RETURN",
              "    IF(OrderCount > 1, \"Repeat\", \"One-Time\")",
              ""
            ],
