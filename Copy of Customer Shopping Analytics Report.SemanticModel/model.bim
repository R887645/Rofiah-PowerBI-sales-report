              "    [MoM_New_AOV] < 0, \"RED\",",
              "    \"#000000\"",
              ")",
              ""
            ],
            "lineageTag": "97220adb-246e-4372-b25b-2a81bbbd63e5"
          },
          {
            "name": "Revenue_YoY",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Rev",
            "expression": [
              "",
              "VAR CurrentYear = MAX('Calendar'[Year])",
              "VAR PrevYear = CurrentYear - 1",
              "VAR RevenueCurrent = CALCULATE([Total Revenue], 'Calendar'[Year] = CurrentYear)",
              "VAR RevenuePrev = CALCULATE([Total Revenue], 'Calendar'[Year] = PrevYear)",
              "RETURN",
              "DIVIDE(RevenueCurrent - RevenuePrev, RevenuePrev)",
              ""
            ],
            "lineageTag": "98a5b68a-69db-49b4-b109-e3a3521eee9e"
          },
