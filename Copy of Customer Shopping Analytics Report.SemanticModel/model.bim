              "VAR Negative_Arrow = UNICHAR(9660)   // ▼ NEGATIVE ARROW",
              "VAR QTY = [Total Quantity]",
              "VAR PYQTY = [PY_Qty]",
              "VAR Growth = DIVIDE(QTY - PYQTY, PYQTY, 0)",
              "RETURN",
