        "lineageTag": "a14850d1-a024-4d5f-9244-f29bba2bc7f2",
        "measures": [
          {
            "name": "Customer_Growth_MoM (%)",
            "expression": [
              "",
              "VAR CurrentMonthCustomers = [Total Customer]",
              "VAR PreviousMonthCustomers =",
              "    CALCULATE(",
              "        [Total Customer],",
              "        DATEADD('Calendar'[Date], -1, MONTH)",
              "    )",
              "RETURN",
              "IF(",
              "    NOT(ISBLANK(PreviousMonthCustomers)) && PreviousMonthCustomers <> 0,",
              "    DIVIDE(CurrentMonthCustomers - PreviousMonthCustomers, PreviousMonthCustomers),",
              "    BLANK()",
              ")",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "9ebcab41-a55b-4a45-9966-19a532a12304"
          }
        ],
        "partitions": [
          {
            "name": "CustomerSummary",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "SUMMARIZE(",
                "    'Customer_FACT',",
                "    'Customer_FACT'[customer_id],",
                "    \"TotalSpend\", [Total Revenue]",
                ")",
                ""
              ],
              "type": "calculated"
            }
          }
