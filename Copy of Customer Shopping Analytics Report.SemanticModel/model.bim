        "measures": [
          {
            "name": "Total Customer",
            "expression": "DISTINCTCOUNT(Customer_FACT[customer_id])",
            "formatString": "#,0",
            "lineageTag": "df4ee49a-c6b9-41b0-853e-b6291cdf277d"
          },
          {
            "name": "Revenue by Segment",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Revenue],",
              "    ALLEXCEPT(CustomerSummary, CustomerSummary[Customer Segment])",
              ")",
              ""
            ],
            "formatString": "0",
            "lineageTag": "2878b31b-9d1f-417a-a453-e52c47b7aed2"
          },
          {
            "name": "Segment Revenue %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue],",
              "    CALCULATE([Total Revenue], ALL(CustomerSummary[Customer Segment])),",
              "    0",
              ")",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "f7e1021c-981c-48b2-8f3c-dc29bdafca45"
          }
        ],
