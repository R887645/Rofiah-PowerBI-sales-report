              "SWITCH(",
              "    TRUE(),",
              "    [TotalSpend] <= 8750, \"Low Spender\",",
              "    [TotalSpend] <= 17500, \"Medium Spender\",",
              "    \"High Spender\"",
              ")",
              ""
            ],
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "7a635f81-27dc-4fb0-8144-f4e4a4758db2",
